{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dorman/loglens/releases/download/v1/loglens-release.schema.json",
  "title": "loglens signed release manifest",
  "type": "object",
  "required": ["schema", "repository", "version", "targets"],
  "properties": {
    "schema": { "const": "loglens-release/v1" },
    "repository": { "const": "dorman/loglens" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "installer", "payload"],
        "properties": {
          "target": { "type": "string" },
          "installer": { "$ref": "#/$defs/artifact" },
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/artifact" },
              {
                "type": "object",
                "required": ["archiveFormat", "executableSha256"],
                "properties": {
                  "archiveFormat": { "enum": ["tar.gz", "zip"] },
                  "executableSha256": { "$ref": "#/$defs/sha256" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["filename", "url", "sha256", "signatureUrl", "signatureScheme", "signingKeyId"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/dorman/loglens/releases/download/v"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signatureUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/dorman/loglens/releases/download/v"
        },
        "signatureScheme": { "const": "Ed25519" },
        "signingKeyId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
