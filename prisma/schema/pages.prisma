// @polsia:user-owned — app-owned marketing page content model.

enum MarketingPageStatus {
  DRAFT
  PUBLISHED
}

model MarketingPage {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  body            String             @db.Text
  seoDescription  String             @db.Text
  content         Json?
  status          MarketingPageStatus @default(DRAFT)
  publishedAt     DateTime?
  sourceKey       String?
  sourcePath      String?
  templateKey     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  draft           MarketingPageDraft?
  @@index([sourceKey])
}

model MarketingPageDraft {
  id             String        @id @default(cuid())
  pageId         String        @unique
  title          String
  slug           String
  body           String        @db.Text
  seoDescription String        @db.Text
  content        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  page MarketingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}
